		(uuid "2dc08e37-7b1a-4455-b0a8-2bf5eecec532")
	)
	(text_box "Raspberry Pi Pico 2 microcontroller is used as the master for the system.\nProvides a MCK, LRCK, BCK, and V_{dd} for the peripherals.\n\n\n"
		(exclude_from_sim no)
		(at 13.97 94.8324 0)
		(size 78.74 8.0376)
