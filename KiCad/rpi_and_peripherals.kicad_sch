		(uuid "7d22d6b1-a7c9-4ce5-a76c-d71d3befdde0")
	)
	(text_box "MD1 & MD0 set the device into slave mode, which autodetects f_{s}. \n\nFMT selects which channel (L or R) is sampled first. \n\nV_{REF} currently set to 5V, set by AFE power-rails. \n\n"
		(exclude_from_sim no)
		(at 232.41 50.8 0)
