	(text_box "Power system circuit(s)\n\nThe MCP1703T-5002E/DB or 3302E are LDO Regulators, capable of supplying 250mA of current.\n\nA 5V supply to the RPi Pico, a digital 3V3 supply if needed, a 5V analog and 3V3 analog.\n\nCircuits shown were pulled from their collective data sheets. "
		(exclude_from_sim no)
		(at 197.485 21.59 0)
		(size 99.06 16.2161)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "32697982-1640-4166-88ae-5add52f13a1a")
	)
	(text_box "Power system circuit\n\nThe IC shown is the LT1054 \nThe data sheet contains a basic voltage inverter, which has been followed exactly here.\n\nThe example was found on TI.com's datasheet for the device, but the one shown in KiCad is by Analog \nDevices. Both are exactly equivalent.\n"
		(exclude_from_sim no)
		(at 78.105 17.145 0)
		(size 115.57 21.59)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f3c40989-c6dd-4fa6-a747-b487d7c1c78e")
	)
